# Cloudflare tunnel for the Companion web UI (companion-updater#26).
#
# A second cloudflared, next to the presenter project's cloudflared.service:
# `cloudflared service install` only ever writes cloudflared.service, so neither
# project can knock out the other's tunnel. The tunnel run token lives in
# /etc/cloudflared-companion.env (TUNNEL_TOKEN=..., root 0600), written by
# `host/cloudflare_companion.py install-token`; it never appears in this file
# or on a command line.
[Unit]
Description=cloudflared (Companion web UI tunnel)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/cloudflared-companion.env

[Service]
Type=notify
# First edge registration on a slow uplink at boot can take longer than 15 s.
TimeoutStartSec=60
# PID 1 reads the root-0600 file before dropping to the dynamic user.
EnvironmentFile=/etc/cloudflared-companion.env
# /usr/local/bin/cloudflared is a symlink to this file on both rigs; the binary is
# kept up to date by cloudflared-update.timer.
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run
# always: cloudflared exits 0 on SIGTERM, so a `pkill cloudflared` aimed at the
# presenter's tunnel would otherwise leave this one down until a reboot.
Restart=always
RestartSec=5s
# cloudflared needs no root and no state in token mode.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
